{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "paths": {
      "@spartan-ng/helm/skeleton": ["./src/lib/ui/skeleton/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/lib/ui/utils/src/index.ts"],
      "@spartan-ng/helm/spinner": ["./src/lib/ui/spinner/src/index.ts"],
      "@spartan-ng/helm/separator": ["./src/lib/ui/separator/src/index.ts"],
      "@spartan-ng/helm/badge": ["./src/lib/ui/badge/src/index.ts"],
      "@spartan-ng/helm/avatar": ["./src/lib/ui/avatar/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./src/lib/ui/textarea/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/lib/ui/input/src/index.ts"],
      "@spartan-ng/helm/alert": ["./src/lib/ui/alert/src/index.ts"],
      "@spartan-ng/helm/sonner": ["./src/lib/ui/sonner/src/index.ts"],
      "@spartan-ng/helm/progress": ["./src/lib/ui/progress/src/index.ts"],
      "@spartan-ng/helm/tabs": ["./src/lib/ui/tabs/src/index.ts"],
      "@spartan-ng/helm/button": ["./src/lib/ui/button/src/index.ts"],
      "@spartan-ng/helm/dropdown-menu": [
        "./src/lib/ui/dropdown-menu/src/index.ts"
      ],
      "@spartan-ng/helm/popover": ["./src/lib/ui/popover/src/index.ts"],
      "@spartan-ng/helm/tooltip": ["./src/lib/ui/tooltip/src/index.ts"],
      "@spartan-ng/helm/select": ["./src/lib/ui/select/src/index.ts"],
      "@spartan-ng/helm/toggle-group": [
        "./src/lib/ui/toggle-group/src/index.ts"
      ],
      "@spartan-ng/helm/toggle": ["./src/lib/ui/toggle/src/index.ts"],
      "@spartan-ng/helm/input-otp": ["./src/lib/ui/input-otp/src/index.ts"],
      "@spartan-ng/helm/card": ["./src/lib/ui/card/src/index.ts"],
      "@spartan-ng/helm/sheet": ["./src/lib/ui/sheet/src/index.ts"],
      "@spartan-ng/helm/alert-dialog": [
        "./src/lib/ui/alert-dialog/src/index.ts"
      ],
      "@spartan-ng/helm/date-picker": ["./src/lib/ui/date-picker/src/index.ts"],
      "@spartan-ng/helm/calendar": ["./src/lib/ui/calendar/src/index.ts"],
      "@spartan-ng/helm/input-group": ["./src/lib/ui/input-group/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
